@page
@model Razor2web.Pages.employees.listModel
@{
}
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal" id="load">add employee </button>
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New message</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="employeeForm">
                    <div class="mb-3">
                        <label>Full Name</label>
                        <input type="text" class="form-control" id="fullname" name="e.Name" required />
                    </div>

                    <div class="mb-3">
                        <label>Gender</label>
                        <input type="radio" name="e.gender" value="male" id="male" /><label for="male">Male</label>
                        <input type="radio" name="e.gender" value="female" id="female" /><label for="female">Female</label>
                    </div>

                    <label for="jobSelect">Job</label>

                    <select id="jobSelect" class="form-control"  name="e.gob_description"  required>
                        <option value="">Select a job</option>
                    </select>


                    <div class="mb-3">
                        <label>Department</label>
                        <input type="text" class="form-control" name="e.department" id="department" required />
                    </div>

                    <div class="mb-3">
                        <label>Start Work At</label>
                        <input type="time" class="form-control" name="e.startShift" id="startShift" required />
                    </div>

                    <div class="mb-3">
                        <label>End Work At</label>
                        <input type="time" class="form-control" name="e.endShift" id="endShift" required />
                    </div>

                    <button type="submit" id="save" class="btn btn-primary" name="save">Save</button>
                
                </div>
                <div id="message"></div>
            </div>
            
        </div>
    </div>
</div>
