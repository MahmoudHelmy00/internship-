@page
@model Razor2web.Pages.jobs.listModel

<h1>Jobs List</h1>

<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal" id="load">add job </button>
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New message</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="addJobForm">
                    <div class="mb-3">
                        <label>job Name</label>
                        <input type="text" class="form-control" id="fullname"  required />
                    </div>

                   

                    <div class="mb-3">
                        <label>Job Description</label>
                        <input type="text" class="form-control"  id="job_description" required />
                    </div>

                    <div class="mb-3">
                        <label>Department</label>
                        <input type="text" class="form-control" name="e.department" id="department" required />
                    </div>

                    <div class="mb-3">
                        <label>salary</label>
                        <input type="text" class="form-control" name="job.salary" id="salary" required />
                    </div>

                    <button type="submit" id="save" class="btn btn-primary" name="save">Save</button>

                </div>
                <div id="message"></div>
            </div>

        </div>
    </div>
</div>


<table class="table table-striped" id="example">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Department</th>
            <th>Salary</th>
            <th>edit</th>
            <th>delete</th>

        </tr>
    </thead>

    <tbody>
        @foreach (var job in Model.jobList)
        {
            <tr>
                <td>@job.Id</td>
                <td>@job.Name</td>
                <td>@job.Description</td>
                <td>@job.department</td>
                <td>@job.salary</td>
                <th>edit</th>
                <th>delete</th>

            </tr>
        }
    </tbody>
</table>
<script>

    $(document).ready(function () {

               var jobData = {}; // In-memory storage for employee data
               var datatable = $('#example').DataTable();
           $.ajax({
                url: '@Url.Page("/jobs/list", "JobsJson")', // Adjust the URL as per your route
                type: 'GET',
                success: function (job) {
                  
                    datatable.clear();
                    $.each(job, function (index, item) {
                        datatable.row.add([
                            item.Id,
                            item.name,
                            item.department,
                            item.gob_description,
                            item.salary,
                            
                            `<button type="button" class="btn btn-primary edit-btn" data-toggle="modal" data-id="${item.id}" data-name="${item.name}" data-department="${item.department}"
                                                                    data-gender="${item.gender}"  data-endShift="${item.endShift}" data-startShift="${item.startShift}" data-gob_description="${item.gob_description}" data-target="#exampleModalUpdate">Edit</button></td>`,
                            `<button class="btn btn-danger delete-btn" data-id="${item.id}">Delete</button>`
                        ]);

                    });
                    datatable.draw();
                },
                error: function () {
                    alert('Error fetching employee data');
                }
            });


        $('#save').click(function () {
            var datatosend =
            {
                Name: $('#fullname').val(),
                department: $('#department').val(),
                Description: $('#job_description').val(),
                salary: parseInt($('#salary').val())
            };
             $.ajax({
                url: '?handler=AddJob',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(datatosend),
                success: function (response) 
                {

                    if (response.success) {
                        $('#message').text('Employee has been created successfully').css('color', 'green');
                        window.location.href = '/employees/list';
                    } else {
                        $('#message').text('Failed to create employee').css('color', 'red');
                    }
                },
                error: function (xhr, status, error)
                {
                    $('#message').text('An error occurred: ' + error).css('color', 'red');
                }
            });

        });
           
    });
</script>