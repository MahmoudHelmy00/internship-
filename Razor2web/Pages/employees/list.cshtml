    $(document).ready(function () {

        // =========================================================
        // 1. INITIALIZE DATATABLE
        // =========================================================

        var datatable = $('#example').DataTable();


        // =========================================================
        // 2. LOAD EMPLOYEES
        // =========================================================

        $.ajax({
            url: '@Url.Page("/employees/list", "EmployeesJson")',
            type: 'GET',

            success: function (employees) {

                datatable.clear();

                $.each(employees, function (index, item) {

                    datatable.row.add([
                        item.id,
                        item.department,
                        item.gender,
                        item.name,
                        item.startShift,
                        item.endShift,

                        // Edit button
                        `<button type="button"
                            class="btn btn-primary edit-btn"
                            data-toggle="modal"
                            data-id="${item.id}"
                            data-name="${item.name}"
                            data-department="${item.department}"
                            data-gender="${item.gender}"
                            data-endShift="${item.endShift}"
                            data-startShift="${item.startShift}"
                            data-gob_description="${item.gob_description}"
                            data-target="#exampleModalUpdate">
                            Edit
                        </button>`,

                        // Delete button
                        `<button
                            type="button"
                            class="btn btn-danger delete-btn"
                            data-id="${item.id}">
                            Delete
                        </button>`
                    ]);

                });

                datatable.draw();
            },

            error: function () {
                alert('Error fetching employee data');
            }
        });


        // =========================================================
        // 3. VARIABLE FOR EMPLOYEE ID
        // =========================================================

        var id;


        // =========================================================
        // 4. EDIT BUTTON
        // =========================================================

        $("#example").on('click', '.edit-btn', function () {

            id = $(this).data('id');

            var name = $(this).data('name');
            var department = $(this).data('department');
            var gender = $(this).data('gender');
            var startShift = $(this).data('startshift');
            var endShift = $(this).data('endshift');
            var gob_description = $(this).data('gob_description');


            $('#Fullname').val(name);

            $('#Department').val(department);

            $('input[name="e.newGender"][value="' + gender + '"]')
                .prop('checked', true);

            $('#Gob_description').val(gob_description);

            $('#newStartShift').val(startShift);

            $('#newEndShift').val(endShift);

        });


        // =========================================================
        // 5. DELETE EMPLOYEE
        // =========================================================

        $("#example").on('click', '.delete-btn', function () {

            var deleteId = $(this).data('id');

            if (confirm("Are you sure you want to delete this employee?")) {

                $.ajax({

                    url: '?handler=Delete',

                    method: 'POST',

                    contentType: 'application/json',

                    data: JSON.stringify(deleteId),

                    success: function (response) {

                        if (response.success) {

                            $('#message')
                                .text('Employee has been deleted successfully')
                                .css('color', 'green');

                            window.location.href = '/employees/list';

                        } else {

                            $('#message')
                                .text('Failed to delete employee')
                                .css('color', 'red');
                        }
                    },

                    error: function (xhr, status, error) {

                        console.log(xhr.responseText);

                        $('#message')
                            .text('An error occurred: ' + error)
                            .css('color', 'red');
                    }
                });
            }
        });


        // =========================================================
        // 6. UPDATE EMPLOYEE
        // =========================================================

        $("#update").click(function (event) {

            event.preventDefault();


            var updatedData = {

                Id: id,

                Name: $('#Fullname').val(),

                gender: $('input[name="e.newGender"]:checked').val(),

                department: $('#Department').val(),

                gob_description: $('#Gob_description').val(),

                startShift: $('#newStartShift').val(),

                endShift: $('#newEndShift').val()
            };


            console.log("Update data:", updatedData);


            $.ajax({

                url: '?handler=Update',

                method: 'POST',

                contentType: 'application/json',

                data: JSON.stringify(updatedData),

                success: function (response) {

                    console.log("Update response:", response);

                    if (response.success) {

                        $('#message')
                            .text('Employee updated successfully')
                            .css('color', 'green');

                        window.location.href = '/employees/list';

                    } else {

                        $('#message')
                            .text(response.message || 'Failed to update employee')
                            .css('color', 'red');
                    }
                },

                error: function (xhr, status, error) {

                    console.log("Update error:", xhr.responseText);

                    $('#message')
                        .text('An error occurred: ' + error)
                        .css('color', 'red');
                }
            });

        });


        // =========================================================
        // 7. OPEN ADD EMPLOYEE MODAL
        // =========================================================

        $('#exampleModal').on('shown.bs.modal', function () {

            loadJobs();

        });


        // =========================================================
        // 8. LOAD JOBS INTO DROPDOWN
        // =========================================================

        function loadJobs() {

            $.ajax({

                url: '?handler=JobResult',

                type: 'GET',

                success: function (jobs) {

                    console.log("Jobs received:", jobs);


                    var jobSelect = $('#jobSelect');


                    // Remove old options
                    jobSelect.empty();


                    // Add default option
                    jobSelect.append(
                        '<option value="">Select a job</option>'
                    );


                    // Add jobs
                    $.each(jobs, function (index, job) {

                        jobSelect.append(

                            '<option value="' +
                            job.id +
                            '">' +
                            job.name +
                            '</option>'

                        );

                    });

                },

                error: function (xhr, status, error) {

                    console.log("Job loading error:", xhr.responseText);

                    alert('Error loading jobs');
                }
            });
        }


        // =========================================================
        // 9. SAVE NEW EMPLOYEE
        // =========================================================

        $('#save').click(function (event) {

            event.preventDefault();


            var datatosend = {

                Name: $('#fullname').val(),

                gender: $('input[name="e.gender"]:checked').val(),

                department: $('#department').val(),

                JobId: parseInt($('#jobSelect').val()),

                startShift: $('#startShift').val(),

                endShift: $('#endShift').val()
            };


            console.log("Employee data being sent:");

            console.log(datatosend);


            // Make sure a job was selected
            if (!datatosend.JobId || isNaN(datatosend.JobId)) {

                $('#message')
                    .text('Please select a job')
                    .css('color', 'red');

                return;
            }


            // Send employee to backend
            $.ajax({

                url: '?handler=Employee',

                method: 'POST',

                contentType: 'application/json',

                data: JSON.stringify(datatosend),


                success: function (response) {

                    console.log("Save response:", response);


                    if (response.success) {

                        $('#message')
                            .text('Employee has been created successfully')
                            .css('color', 'green');


                        window.location.href = '/employees/list';

                    } else {

                        $('#message')
                            .text(response.message || 'Failed to create employee')
                            .css('color', 'red');
                    }
                },


                error: function (xhr, status, error) {

                    console.log("Save error status:", status);

                    console.log("Save error:", error);

                    console.log("Server response:", xhr.responseText);


                    $('#message')
                        .text('An error occurred: ' + error)
                        .css('color', 'red');
                }
            });

        });

    });

    </script>


